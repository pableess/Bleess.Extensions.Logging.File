{
  "Logging": {

    "Files": {

      "TraceLog": {
        "Path": "logs/trace.txt",
        "RollInterval": "Hour",
        "FormatterOptions": {
          "IncludeScopes": false,
          "SingleLine": true,
          "EmptyLineBetweenMessages": false,
          "TimestampFormat": "yyyy-MM-dd h:mm tt",
          "UseUtcTimestamp": true
        },
        "LogLevel": {
          "Default": "Trace",
          "Microsoft": "Warning"
        }
      },

      "ErrorLog": {
        "Path": "logs/errors.json"
      }
    },

    "File": {
      "Path": "logs/sample.txt",
      "MaxFlushInterval": 2000,
      "FlushToDisk": true,
      "FormatterOptions": {
        "IncludeScopes": false,
        "SingleLine": false,
        "EmptyLineBetweenMessages": true,
        "TimestampFormat": "yyyy-MM-dd h:mm tt",
        "UseUtcTimestamp": false
      }
    }
  }
}
