{
  "Logging": {

    "File": {
      "IncludeScopes": true,
      "Path": "logs/log.txt",
      "MaxNumberFiles": 7,
      "MaxFileSizeInMB": 50, // this can be decimal
      "FormatterName": "simple",
      "Append": true,
      "LogLevel": {
        "Default": "Information"
      }
    },

    "Files": {

      "Foo": {
        "IncludeScopes": true,
        "Path": "logs/foo.txt",
        "MaxNumberFiles": 8,
        "MaxFileSizeInMB": 10, // this can be decimal
        "FormatterName": "json",
        "Append": true,
        "LogLevel": {
          "Default": "Warning"
        }
      },

      "Bar": {
        "IncludeScopes": true,
        "Path": "logs/bar.txt",
        "MaxNumberFiles": 7,
        "MaxFileSizeInMB": 15, // this can be decimal
        "FormatterName": "simple",
        "Append": true,
        "LogLevel": {
          "Default": "Information"
        },

        "FormatterOptions": {
          "IncludeScopes": false,
          "SingleLine": true,
          "EmptyLineBetweenMessages": true,
          "TimestampFormat": "yyyy-MM-dd h:mm tt",
          "UseUtcTimestamp": true
        }
      }
    },

    "LogLevel": {
      "Default": "Information"
    }
  }
}
