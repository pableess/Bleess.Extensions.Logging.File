<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 is EOL; kept only for consumers that cannot move yet. net10.0 (LTS) and net11.0 are current. -->
    <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>

    <RepoRoot>$([System.IO.Path]::GetDirectoryName($([MSBuild]::GetPathOfFileAbove('.gitignore', '$(MSBuildThisFileDirectory)'))))</RepoRoot>

    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- the library does not use reflection over user types, so it is trim/AOT safe -->
    <IsAotCompatible>true</IsAotCompatible>

    <BuildNum>1</BuildNum>

    <VersionPrefix>4.0.2</VersionPrefix>
    <VersionSuffix></VersionSuffix>

    <FileVersion>$(VersionPrefix).$(BuildNum)</FileVersion>

    <Authors>Paul Bleess</Authors>
    <Description>Simple file logger for dotnet Microsoft.Extensions.Logging</Description>
    <Title>File logging for Microsoft.Extensions.Logging</Title>
    <Copyright>Copyright (c) 2026 Paul Bleess and contributors</Copyright>
    <AssemblyTitle>Bleess.Extensions.Logging.File</AssemblyTitle>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Bleess.Extensions.Logging.File</AssemblyName>
    <PackageId>Bleess.Extensions.Logging.File</PackageId>
    <PackageTags>microsoft-extensions-logging;log;file;file-logging;logging;aspnetcore;file-logger;logging-provider;netcore</PackageTags>
    <PackageProjectUrl>https://github.com/pableess/Bleess.Extensions.Logging.File</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <PackageReleaseNotes>
      How to use: https://github.com/pableess/Bleess.Extensions.Logging.File

      Breaking changes in 4.0:
      - Targets .NET 8, .NET 10 and .NET 11 (net6.0 and net9.0 were dropped, both are out of support)
      - FileLoggerProvider takes a TimeProvider; AddFile/AddFiles register TimeProvider.System if none is registered
      - File logger options are validated on startup (Path, MaxNumberFiles, MaxFileSizeInMB, MaxFlushInterval)
      - Date based rolling can use UTC via FileLoggerOptions.UseUtcTimestamp

      Fixes:
      - Configuration changes now reload the file provider options (path, limits, formatter, flush settings)
      - Composite logger IsEnabled reports enabled when any sub logger is enabled
      - WithFilter(Func&lt;string?, LogLevel, bool&gt;) no longer ignores the predicate
      - WithFormatter uses the formatter name it was given and applies formatter options to the sub provider
      - Writer swaps no longer race with the write thread; the write thread owns the writer lifecycle
    </PackageReleaseNotes>


    <!-- Publish the repository URL in the built .nupkg (in the NuSpec <Repository> element) -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- Embed source files that are not tracked by the source control manager in the PDB -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Recommended: Embed symbols containing Source Link in the main file (exe/dll) -->
    <DebugType>embedded</DebugType>

    <ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

  </PropertyGroup>


  <ItemGroup>
    <None Include="$(RepoRoot)\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework) == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework) == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework) == 'net11.0'">
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" />
  </ItemGroup>
</Project>
